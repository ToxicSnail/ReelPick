# Единственный обязательный секрет: токен Telegram от @BotFather.
BOT_TOKEN=1234567890:replace_me

DATABASE_PATH=./data/kinotyk.sqlite3
MIN_IMDB_RATING=6.0
CINEMETA_SKIPS=0,100,200,300
HTTP_TIMEOUT_SECONDS=12
TELEGRAM_POLL_TIMEOUT_SECONDS=30
MAX_OVERVIEW_CHARS=520
LOG_LEVEL=INFO

# Внешние источники без регистрации и API-ключей.
CINEMETA_BASE_URL=https://v3-cinemeta.strem.io
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
WIKIPEDIA_API_URL=https://ru.wikipedia.org/w/api.php
HTTP_USER_AGENT="Kinotyk/1.1 (Telegram movie discovery bot)"
